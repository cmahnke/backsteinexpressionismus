{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "useDefineForClassFields": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "ts/*": ["./themes/projektemacher-base/assets/ts/*"]
    }
  },
  "include": [
    "assets/ts/**/*.ts",
    "themes/projektemacher-base/assets/ts/globals.d.ts",
    "themes/projektemacher-base/assets/ts/vendor.d.ts"
  ]
}
