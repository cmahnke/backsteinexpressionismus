{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "useDefineForClassFields": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "ts/*": ["themes/projektemacher-base/assets/ts/*"],
      "./iiif-image-viewer": ["themes/projektemacher-base/assets/ts/iiif-image-viewer.ts"]
    }
  },
  "include": ["assets/ts/**/*.ts"]
}
