Karte\u0022\u003e\u003c\/div\u003e\n      \u003cdiv id=\u002260c664f00cb436b977f46d4a14780d21-popup\u0022 class=\u0022ol-popup\u0022\u003e\n        \u003ca href=\u0022#\u0022 id=\u002260c664f00cb436b977f46d4a14780d21-popup-closer\u0022 class=\u0022ol-popup-closer\u0022 role=\u0022button\u0022 aria-label=\u0022Schließen\u0022\u003e\u003c\/a\u003e\n        \u003cdiv id=\u002260c664f00cb436b977f46d4a14780d21-popup-content\u0022 class=\u0022ol-popup-content\u0022 aria-live=\u0022polite\u0022\u003e\u003c\/div\u003e\n      \u003c\/div\u003e\n    \u003c\/div\u003e\n    \u003cscript type=\u0022text\/javascript\u0022\u003e\n      (function() {\n        var start = function() {\n          var _60c664f00cb436b977f46d4a14780d21 = window.projektemacherMap(\u002760c664f00cb436b977f46d4a14780d21\u0027, \u0027\\\/lists\\\/buildings\\\/map.geojson\u0027, \u0027\u0027, \u0027https:\/\/backsteinexpressionismus.projektemacher.org\/map-styles\/graybeard.json\u0027, undefined, undefined, undefined, undefined, undefined, true, false, true, undefined, false, {src: \u0022\/images\/map-marker.svg\u0022, scale: 0.1243, anchor: [0.5, 1], anchorXUnits: \u0022fraction\u0022, anchorYUnits: \u0022fraction\u0022});\n          document.getElementById(\u002760c664f00cb436b977f46d4a14780d21-popup-closer\u0027).addEventListener(\u0027keydown\u0027, function(event) {\n            if (event.key === \u0027 \u0027 || event.key === \u0027Spacebar\u0027) {\n              event.preventDefault();\n              this.click();\n            }\n          });\n        };\n        if (document.readyState === \u0027loading\u0027) {\n          document.addEventListener(\u0027DOMContentLoaded\u0027, start);\n        } else {\n          start();\n        }\n      })();\n    \u003c\/script\u003e\n\n&#39;);&#xA;    });&#xA;  &lt;/script&gt;&#xA;&lt;/div&gt;</description>
